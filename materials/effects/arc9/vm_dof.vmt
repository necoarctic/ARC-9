screenspace_general
{
	$pixshader "arc9_vm_dof_ps30"
	// $pixshader "arc9_vm_dof_sm2test_ps20b" // pixel shader 2.0 variant, still crashes on intel
	$vertexshader 	"arc9_pp_vs30"

	$basetexture "_rt_FullFrameFB"
	$texture1    "_rt_ResolvedFullFrameDepth"

	$vertexcolor 1
	$vertextransform 1
	$ignorez        1
	$fix_fb         32768
	"<dx90"
	{
		$no_draw 1
	}
	
	$copyalpha                 1
	$alpha_blend_color_overlay 0
	$alpha_blend               0
	$linearwrite               0
	$linearread_basetexture    0
	$linearread_texture1       0
	$linearread_texture2       0
	$linearread_texture3       0

	$c0_x     0.000390625
	$c0_y     0.00069444444444444


	$c1_x     10
	$c1_y     0.07
}
